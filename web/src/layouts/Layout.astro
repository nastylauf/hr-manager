---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17243d" />
    <title>{title} — HR Manager</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="HR Manager — главная">
        <span class="brand-mark" aria-hidden="true">h</span>
        <span>hr<span class="brand-light">manager</span></span>
      </a>
      <nav aria-label="Основная навигация">
        <a class:list={["nav-link", { active: Astro.url.pathname.startsWith("/resumes") }]} href="/resumes">Резюме</a>
        <a class:list={["nav-link", { active: Astro.url.pathname.startsWith("/vacancies") }]} href="/vacancies">Вакансии</a>
        <a class:list={["nav-link", { active: Astro.url.pathname.startsWith("/matching") }]} href="/matching">Подбор</a>
      </nav>
      <a class="header-home" href="/">HR Manager <span aria-hidden="true">↗</span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span class="footer-brand">hr<span class="brand-light">manager</span></span>
      <span>Рабочее пространство рекрутера</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    color: #17243d;
    background: #f4f6fb;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --navy: #17243d;
    --navy-soft: #263754;
    --blue: #4263eb;
    --blue-dark: #3452d1;
    --blue-pale: #edf1ff;
    --ink: #17243d;
    --muted: #78849a;
    --line: #e6eaf2;
    --surface: #fff;
    --danger: #c94c5b;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 max(5vw, calc((100vw - 1200px) / 2));
    background: var(--navy);
    color: #fff;
    box-shadow: 0 8px 24px rgba(19, 34, 59, .12);
  }
  header a { color: inherit; text-decoration: none; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 800; letter-spacing: -.5px; }
  .brand-mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px; background: var(--blue); color: white; font-size: 23px; line-height: 1; }
  .brand-light { font-weight: 400; color: #aebbd1; }
  nav { height: 100%; display: flex; align-items: center; gap: 8px; }
  .nav-link { position: relative; padding: 10px 14px; border-radius: 9px; color: #c1ccdc; font-size: 14px; transition: background .18s ease, color .18s ease; }
  .nav-link:hover, .nav-link.active { background: rgba(255,255,255,.1); color: #fff; }
  .nav-link.active::after { position: absolute; right: 14px; bottom: -16px; left: 14px; height: 3px; border-radius: 3px; background: #8195ff; content: ""; }
  .header-home { color: #c1ccdc; font-size: 13px; }
  .header-home span { margin-left: 5px; color: #9aabff; }
  main { width: min(1200px, 100%); min-height: calc(100vh - 142px); margin: 0 auto; padding: 48px 28px 64px; }
  footer { min-height: 66px; display: flex; align-items: center; justify-content: space-between; padding: 0 max(5vw, calc((100vw - 1200px) / 2)); border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .footer-brand { color: var(--navy); font-size: 13px; font-weight: 800; }
  h1 { margin: 0 0 12px; color: var(--ink); font-size: clamp(26px, 4vw, 34px); letter-spacing: -1px; }
  h2 { margin: 38px 0 16px; color: var(--ink); font-size: 21px; letter-spacing: -.4px; }
  h3 { margin: 0 0 10px; color: var(--ink); }
  p { line-height: 1.65; }
  .page-heading { margin-bottom: 26px; }
  .page-heading p { margin: 0; color: var(--muted); }
  .toolbar { display: flex; gap: 10px; margin-bottom: 20px; padding: 14px; flex-wrap: wrap; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  input, select, textarea {
    min-width: 0;
    border: 1px solid #dce2ed;
    border-radius: 9px;
    padding: 11px 13px;
    outline: none;
    background: white;
    color: var(--ink);
    font: inherit;
    transition: border-color .16s ease, box-shadow .16s ease;
  }
  input:focus, select:focus, textarea:focus { border-color: #8195ff; box-shadow: 0 0 0 3px rgba(66,99,235,.12); }
  input::placeholder { color: #9aa4b6; }
  textarea { min-height: 96px; resize: vertical; }
  button, .button {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 10px 15px;
    background: var(--blue);
    color: white;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    transition: transform .16s ease, background .16s ease, box-shadow .16s ease;
  }
  button:hover, .button:hover { transform: translateY(-1px); background: var(--blue-dark); box-shadow: 0 5px 14px rgba(66,99,235,.2); }
  button:focus-visible, .button:focus-visible, a:focus-visible { outline: 3px solid #9aabff; outline-offset: 3px; }
  button:disabled { transform: none; cursor: wait; opacity: .65; }
  button.secondary { border-color: #e2e7f0; background: #f7f8fc; color: var(--navy-soft); box-shadow: none; }
  button.secondary:hover { background: var(--blue-pale); color: var(--blue-dark); }
  button.danger { background: var(--danger); }
  button.danger:hover { background: #b43e4d; box-shadow: 0 5px 14px rgba(201,76,91,.18); }
  .card { border: 1px solid var(--line); border-radius: 15px; padding: 21px; background: var(--surface); box-shadow: 0 7px 22px rgba(31,49,82,.045); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .muted { color: var(--muted); }
  .actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .status { min-height: 24px; margin: 12px 0; color: var(--blue-dark); font-size: 14px; }
  .status.error { color: #b42318; }
  form.grid-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 820px; padding: 22px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface); }
  form.grid-form label { display: flex; flex-direction: column; gap: 7px; color: #536078; font-size: 13px; font-weight: 600; }
  form.grid-form .wide { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    header { height: auto; min-height: 68px; padding: 14px 20px; flex-wrap: wrap; gap: 10px; }
    nav { order: 3; width: 100%; height: auto; justify-content: space-between; }
    .nav-link.active::after { bottom: -5px; }
    .header-home { display: none; }
    main { padding: 32px 18px 48px; }
    footer { padding: 0 20px; }
  }
  @media (max-width: 540px) {
    form.grid-form { grid-template-columns: 1fr; padding: 16px; }
    form.grid-form .wide { grid-column: auto; }
    .toolbar > * { width: 100%; }
    .actions > * { flex: 1; }
  }
</style>
