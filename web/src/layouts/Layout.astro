---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — HR Manager</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">HR Manager</a>
      <nav>
        <a href="/resumes">Резюме</a>
        <a href="/vacancies">Вакансии</a>
        <a href="/matching">Подбор</a>
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, Arial, sans-serif; color: #172033; background: #f4f7fb; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 5vw; background: #172033; color: white; }
  header a { color: inherit; text-decoration: none; }
  nav { display: flex; gap: 24px; }
  nav a { color: #dfe7f5; }
  nav a:hover { color: white; }
  .brand { font-size: 20px; font-weight: 800; }
  main { max-width: 1180px; min-height: calc(100vh - 68px); margin: 0 auto; padding: 36px 24px; }
  h1 { margin: 0 0 20px; }
  .toolbar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
  input, select, textarea { border: 1px solid #ccd4e0; border-radius: 8px; padding: 10px 12px; background: white; font: inherit; }
  textarea { min-height: 96px; resize: vertical; }
  button, .button { border: 0; border-radius: 8px; padding: 10px 14px; background: #3157d5; color: white; cursor: pointer; text-decoration: none; }
  button.secondary { background: #e8edf6; color: #172033; }
  button.danger { background: #c84d4d; }
  .card { background: white; border: 1px solid #e3e8f0; border-radius: 12px; padding: 18px; box-shadow: 0 4px 16px rgba(32,48,77,.05); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .muted { color: #667085; }
  .actions { display: flex; gap: 8px; margin-top: 14px; }
  .status { min-height: 24px; color: #3157d5; margin: 12px 0; }
  .status.error { color: #b42318; }
  form.grid-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 760px; }
  form.grid-form label { display: flex; flex-direction: column; gap: 6px; }
  form.grid-form .wide { grid-column: 1 / -1; }
  @media (max-width: 700px) {
    header { height: auto; padding: 16px 20px; align-items: flex-start; }
    nav { gap: 12px; }
    form.grid-form { grid-template-columns: 1fr; }
  }
</style>
